# Gate steps to merge into the CI workflow.
- run: test -z "$(gofmt -l .)"
- run: go vet ./...
- run: staticcheck ./...
- run: golangci-lint run
- run: |
    go test -coverprofile=c.out ./...
    go tool cover -func=c.out | awk '/^total:/{gsub("%","",$3); exit ($3+0 < {{coverage_floor}})}'
- run: govulncheck ./...
# non-blocking: gremlins unleash
